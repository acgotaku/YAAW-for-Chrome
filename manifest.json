{
  "background": {
    "service_worker": "background.js"
  },
  "default_locale": "en",
  "description": "__MSG_description__",
  "icons": {
    "32": "images/logo32.png",
    "64": "images/logo64.png",
    "128": "images/logo128.png"
  },
  "manifest_version": 3,
  "action": {
    "default_icon": "images/logo32.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "alarms",
    "cookies",
    "notifications",
    "tabs",
    "contextMenus",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "name": "__MSG_appName__",
  "version": "0.2.3"
}
